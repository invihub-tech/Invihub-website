name = "invihub-web"
compatibility_date = "2024-09-23"
pages_build_output_dir = "dist"

# For Cloudflare Pages deployment:
# Run: npx wrangler pages deploy dist --project-name=invihub-web
# Or connect GitHub repository to Cloudflare Pages with:
#   Build command: npm run build
#   Build output directory: dist
#   Root directory: invihub-web
