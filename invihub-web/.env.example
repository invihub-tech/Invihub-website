# ─── Frontend (safe to expose via VITE_* — public anon key only) ───────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ADMIN_PATH_KEY=invihub
VITE_RAZORPAY_KEY_ID=your-razorpay-test-key

# ─── NEVER expose these via VITE_* ─────────────────────────────────────────────
# Set the following as Supabase Edge Function secrets:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set RAZORPAY_KEY_SECRET=...
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=...
#   supabase secrets set ALLOWED_ORIGINS=https://invihub-web.invihub.workers.dev
#   supabase secrets set PAYMENT_MODE=mock
#   supabase secrets set ALLOW_MOCK_PAYMENTS=true

# ─── Legacy / local Express dev server (retired for Cloudflare deploy) ─────────
# DATABASE_URL=postgresql://...
# DIRECT_URL=postgresql://...
# JWT_SECRET=...
# API_PORT=8787
