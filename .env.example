# Local and production: Prisma is PostgreSQL (Supabase). SQLite file URLs will not work.
# Direct (port 5432) → DIRECT_URL. Pooler (6543) → DATABASE_URL, often with ?pgbouncer=true
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

JWT_SECRET="replace-me-with-a-long-random-secret-24chars-min"
ADMIN_PATH_KEY="invihub"
VITE_ADMIN_PATH_KEY="invihub"
# Empty VITE_API_URL = same origin /api (Nginx proxy). Separate API host: https://api.example.com
VITE_API_URL=""
API_PORT=8787
# Hosts often set PORT; Express uses PORT || API_PORT || 8787
# PORT=8787
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

PAYMENT_MODE="mock"
# First production launch with mock pay: NODE_ENV=production and ALLOW_MOCK_PAYMENTS=true
# Live Razorpay: PAYMENT_MODE=live and remove ALLOW_MOCK_PAYMENTS; use real keys (not VITE_ for secrets)
ALLOW_MOCK_PAYMENTS="false"
PAYMENT_MOCK_FAIL="false"
RAZORPAY_KEY_ID="dummy_key_not_for_live"
RAZORPAY_KEY_SECRET="dummy_secret_not_for_live"
RAZORPAY_WEBHOOK_SECRET="dummy_webhook_not_for_live"
VITE_RAZORPAY_KEY_ID="dummy_key_not_for_live"

EMAIL_API_KEY="dummy_key"
STORAGE_API_KEY="dummy_key"
SHIPPING_API_KEY="dummy_key"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-me-12chars"

# When true, all /api routes except GET /api/health return 503
MAINTENANCE_MODE="false"
