# Frontend (safe for VITE_* — public anon key only)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_ADMIN_PATH_KEY="invihub"
VITE_RAZORPAY_KEY_ID="dummy_key_not_for_live"

# Do NOT put these in VITE_* or frontend code:
# SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, EMAIL secrets

# Edge Function secrets (set via `supabase secrets set` — not committed)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# ALLOWED_ORIGINS=http://localhost:5173,https://invihub-web.invihub.workers.dev
# PAYMENT_MODE=mock
# ALLOW_MOCK_PAYMENTS=true
# PAYMENT_MOCK_FAIL=false
# RAZORPAY_KEY_ID=dummy_key_not_for_live
# RAZORPAY_KEY_SECRET=dummy_secret_not_for_live
# RAZORPAY_WEBHOOK_SECRET=dummy_webhook_not_for_live
# NODE_ENV=development

# Legacy Express (retired — do not use for new deploys)
# DATABASE_URL=
# DIRECT_URL=
# JWT_SECRET=
# API_PORT=8787
