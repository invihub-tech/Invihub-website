# Example Wrangler config for invihub-web.invihub.workers.dev
# Copy to wrangler.toml when you are ready to deploy (requires your approval).
# public/_redirects does NOT configure Workers SPA fallback — use assets.not_found_handling.

name = "invihub-web"
compatibility_date = "2024-09-23"

# Static Vite build output only (no Express /api worker).
[assets]
directory = "./dist"
not_found_handling = "single-page-application"

# Build in Cloudflare (optional) or build locally then deploy dist/:
# [build]
# command = "npm run build"

# Set these in Cloudflare Dashboard → Workers → Settings → Variables (build-time / Vite):
# VITE_SUPABASE_URL
# VITE_SUPABASE_ANON_KEY
# VITE_ADMIN_PATH_KEY
# VITE_RAZORPAY_KEY_ID
